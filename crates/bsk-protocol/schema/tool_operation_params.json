{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OperationParams",
  "type": "object",
  "required": [
    "operation_id",
    "session_id"
  ],
  "properties": {
    "operation_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "wait_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    }
  }
}
