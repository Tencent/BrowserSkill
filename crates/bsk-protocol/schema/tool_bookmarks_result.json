{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BookmarksResult",
  "type": "object",
  "required": [
    "nodes"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/BookmarkNode"
      }
    },
    "removed_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "definitions": {
    "BookmarkNode": {
      "description": "Chrome's native node shape. Preserve metadata for backups.",
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "children": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/BookmarkNode"
          }
        },
        "dateAdded": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "dateGroupModified": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "dateLastUsed": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "folderType": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "index": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "syncing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "unmodifiable": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
