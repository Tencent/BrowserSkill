{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "browser_relative_dir": {
      "description": "Daemon-injected relative directory beneath Chrome's Downloads root.",
      "type": [
        "string",
        "null"
      ]
    },
    "max_byte_size": {
      "description": "Daemon-injected authoritative transfer size limit. The extension uses\nit only for early cancellation; daemon import remains the final check.",
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout_ms": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "session_id"
  ],
  "title": "DownloadParams",
  "type": "object"
}
