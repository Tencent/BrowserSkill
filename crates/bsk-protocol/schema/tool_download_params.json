{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DownloadParams",
  "type": "object",
  "required": [
    "session_id"
  ],
  "properties": {
    "ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "staging_path": {
      "description": "Daemon-injected destination directory for the browser process.",
      "type": [
        "string",
        "null"
      ]
    },
    "tab_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    }
  }
}
