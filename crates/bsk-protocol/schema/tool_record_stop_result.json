{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FillCommit": {
      "enum": [
        "enter",
        "suggestion",
        "blur"
      ],
      "type": "string"
    },
    "KeyModifier": {
      "description": "Keyboard modifier flags. Multiple flags may be combined; the\nextension folds them into CDP's bitfield (`alt=1, ctrl=2, meta=4,\nshift=8`).",
      "enum": [
        "alt",
        "ctrl",
        "meta",
        "shift"
      ],
      "type": "string"
    },
    "NavigationCause": {
      "enum": [
        "user_typed",
        "link",
        "form_submit",
        "reload",
        "history",
        "script",
        "browser"
      ],
      "type": "string"
    },
    "PageRefV2": {
      "description": "Page context dictionary entry — referenced by steps via `page` id.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "url"
      ],
      "type": "object"
    },
    "RecordedTrace": {
      "else": {
        "$ref": "#/definitions/TraceV2"
      },
      "if": {
        "properties": {
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "$ref": "#/definitions/TraceV3"
      }
    },
    "RecorderInfo": {
      "properties": {
        "bsk": {
          "type": "string"
        },
        "vom": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "bsk",
        "vom"
      ],
      "type": "object"
    },
    "SelectedOptionV2": {
      "description": "One selected option (`select` op).",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "SelectedOptionV3": {
      "description": "One selected option (`select` op).",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "StepEffectV2": {
      "description": "Observed navigation after a step (objective fact only).",
      "properties": {
        "navigated_to": {
          "description": "Reference into `pages[]` for the destination page.",
          "type": "string"
        }
      },
      "required": [
        "navigated_to"
      ],
      "type": "object"
    },
    "StepResultV3": {
      "properties": {
        "state": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "StepV2": {
      "description": "One recorded user action — discriminated union by `op` (v2).",
      "oneOf": [
        {
          "description": "Fields shared by every v2 step variant (flattened in JSON).",
          "properties": {
            "effect": {
              "anyOf": [
