        {
          "description": "Fields shared by every v2 step variant (flattened in JSON).",
          "properties": {
            "effect": {
              "anyOf": [
                {
                  "$ref": "#/definitions/StepEffectV2"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "hover",
              "type": "string"
            },
            "page": {
              "description": "Reference into `pages[]`.",
              "type": "string"
            },
            "target": {
              "$ref": "#/definitions/TargetDescriptorV2"
            }
          },
          "required": [
            "op",
            "id",
            "page",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "Fields shared by every v2 step variant (flattened in JSON).",
          "properties": {
            "effect": {
              "anyOf": [
                {
                  "$ref": "#/definitions/StepEffectV2"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "fill",
              "type": "string"
            },
            "page": {
              "description": "Reference into `pages[]`.",
              "type": "string"
            },
            "redacted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "target": {
              "$ref": "#/definitions/TargetDescriptorV2"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "page",
            "target",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "Fields shared by every v2 step variant (flattened in JSON).",
          "properties": {
            "effect": {
              "anyOf": [
                {
                  "$ref": "#/definitions/StepEffectV2"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "select",
              "type": "string"
            },
            "page": {
              "description": "Reference into `pages[]`.",
              "type": "string"
            },
            "selection": {
              "items": {
                "$ref": "#/definitions/SelectedOptionV2"
              },
              "type": "array"
            },
            "target": {
              "$ref": "#/definitions/TargetDescriptorV2"
            }
          },
          "required": [
            "op",
            "id",
            "page",
            "target",
            "selection"
          ],
          "type": "object"
        },
        {
          "description": "Fields shared by every v2 step variant (flattened in JSON).",
          "properties": {
            "effect": {
              "anyOf": [
                {
                  "$ref": "#/definitions/StepEffectV2"
                },
                {
                  "type": "null"
                }
              ]
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "key": {
              "type": "string"
            },
            "modifiers": {
              "items": {
                "$ref": "#/definitions/KeyModifier"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "op": {
              "const": "press",
              "type": "string"
            },
            "page": {
              "description": "Reference into `pages[]`.",
              "type": "string"
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/definitions/TargetDescriptorV2"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "op",
            "id",
            "page",
            "key"
          ],
          "type": "object"
        }
      ]
