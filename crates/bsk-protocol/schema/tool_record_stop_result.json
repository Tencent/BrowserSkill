            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "navigate",
              "type": "string"
            },
            "result": {
              "$ref": "#/definitions/StepResultV3"
            },
            "state": {
              "description": "Observation id immediately before this action.",
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "state",
            "result",
            "to",
            "cause"
          ],
          "type": "object"
        },
        {
          "description": "Fields shared by every step variant (flattened in JSON).",
          "properties": {
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "switch_tab",
              "type": "string"
            },
            "result": {
