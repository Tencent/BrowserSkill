              "type": "string"
            },
            "target": {
              "$ref": "#/definitions/TargetDescriptorV3"
            }
          },
          "required": [
            "op",
            "id",
            "state",
            "result",
            "target"
          ],
          "type": "object"
        },
        {
          "description": "Fields shared by every step variant (flattened in JSON).",
          "properties": {
            "commit": {
              "$ref": "#/definitions/FillCommit"
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "op": {
              "const": "fill",
              "type": "string"
            },
            "redacted": {
              "type": "boolean"
            },
            "result": {
              "$ref": "#/definitions/StepResultV3"
            },
            "state": {
              "description": "Observation id immediately before this action.",
              "type": "string"
            },
            "target": {
              "$ref": "#/definitions/TargetDescriptorV3"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "id",
            "state",
            "result",
            "target",
            "value",
            "commit"
          ],
          "type": "object"
        },
        {
          "description": "Fields shared by every step variant (flattened in JSON).",
          "properties": {
            "id": {
              "format": "uint32",
              "minimum": 0,
