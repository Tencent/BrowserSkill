    "StopReason": {
      "enum": [
        "user_finish",
        "cli_stop"
      ],
      "type": "string"
    },
    "TargetDescriptorV2": {
      "description": "Stable semantic handle for an interacted element (v2).\n\n`name` and `nearby_label` are **untrusted page text**.",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_attr": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearby_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "type": "object"
    },
    "TargetDescriptorV3": {
      "description": "Stable semantic handle for an interacted element within a page observation.",
      "properties": {
        "ctx": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "unmatched": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "TraceEntry": {
      "properties": {
        "start_url": {
          "type": "string"
        }
      },
      "required": [
        "start_url"
      ],
      "type": "object"
    },
    "TraceStateV3": {
      "description": "Page observation dictionary entry — referenced by steps via `state` / `result.state`.",
      "properties": {
        "body": {
          "description": "Full page observation (front matter + VOM body + annotations).",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "body"
      ],
      "type": "object"
    },
    "TraceV2": {
      "description": "Persisted user-action trace exported by legacy `tool.record_stop` / `await`.\n\nUnknown extension fields are ignored so older traces remain readable.\n`states[]` and a numeric `version` are reserved for Trace v3 / `RecordedTrace`\nclassification — serde still ignores them, but the JSON Schema rejects them.",
      "properties": {
        "entry": {
          "$ref": "#/definitions/TraceEntry"
        },
        "pages": {
          "items": {
            "$ref": "#/definitions/PageRefV2"
          },
          "type": "array"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "description": "RFC 3339 timestamp when recording stopped.",
          "type": "string"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "states": false,
        "steps": {
          "items": {
            "$ref": "#/definitions/StepV2"
          },
          "type": "array"
        },
        "version": {
          "description": "Numeric version selects Trace v3. Legacy v2 envelopes omit this field.",
          "not": {
            "type": "integer"
          }
        }
      },
      "required": [
        "recorded_at",
        "entry",
        "pages",
        "steps"
      ],
      "type": "object"
    },
    "TraceV3": {
      "additionalProperties": false,
      "description": "Wire trace returned by `tool.record_stop` / `await`.",
      "properties": {
        "entry": {
          "$ref": "#/definitions/TraceEntry"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string"
        },
        "recorder": {
          "$ref": "#/definitions/RecorderInfo"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "states": {
          "items": {
            "$ref": "#/definitions/TraceStateV3"
          },
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/StepV3"
          },
          "type": "array"
        },
        "stopped_by": {
          "$ref": "#/definitions/StopReason"
        },
        "version": {
          "const": 3,
          "type": "integer"
        }
      },
      "required": [
        "version",
        "recorded_at",
        "stopped_by",
        "entry",
        "recorder",
        "states",
        "steps"
      ],
      "type": "object"
    }
  },
  "properties": {
    "trace": {
      "$ref": "#/definitions/RecordedTrace"
    }
  },
  "required": [
    "trace"
  ],
  "title": "RecordStopResult",
  "type": "object"
}
