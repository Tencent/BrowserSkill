              "description": "Observation id immediately before this action.",
              "type": "string"
            }
          }
        }
      ]
    },
    "TargetDescriptorV2": {
      "description": "Stable semantic handle for an interacted element (v2).\n\n`name` and `nearby_label` are **untrusted page text**.",
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "name_attr": {
          "type": [
            "string",
            "null"
          ]
        },
        "nearby_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "placeholder": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "TargetDescriptorV3": {
      "description": "Stable semantic handle for an interacted element within a page observation.",
      "type": "object",
      "properties": {
        "ctx": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "unmatched": {
          "type": "boolean"
        }
      }
    }
  }
}
