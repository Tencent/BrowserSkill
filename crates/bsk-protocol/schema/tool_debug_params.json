    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "part": {
      "type": [
        "string",
        "null"
      ]
    },
    "pointer": {
      "type": [
        "string",
        "null"
      ]
