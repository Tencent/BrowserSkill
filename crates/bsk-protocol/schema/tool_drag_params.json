{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DragParams",
  "type": "object",
  "required": [
    "session_id",
    "source"
  ],
  "properties": {
    "button": {
      "anyOf": [
        {
          "$ref": "#/definitions/MouseButton"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_id": {
      "description": "Context actually returned by sync. Reusable for target-policy DOM actions; strict policy consumes it after one action. Never fill it from cached state.",
      "type": "string"
    },
    "delta": {
      "anyOf": [
        {
          "$ref": "#/definitions/DragPoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "depends_on": {
      "description": "Strict policy only: observed decision regions. Target policy requires exact business facts in expect; regions cannot be translated to facts automatically.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 16
    },
    "duration_ms": {
      "description": "Travel duration, excluding hold. Defaults to 500 ms.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 5000.0,
      "minimum": 1.0
    },
    "expect": {
      "description": "Literal conditions checked before input. Selectors search the main document; use observed refs for iframe/shadow-root targets. Text includes all whitespace.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/ActionExpectation"
      },
      "maxItems": 16
    },
    "hold_ms": {
      "description": "Delay after pressing and before moving. Defaults to zero.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 5000.0,
      "minimum": 0.0
    },
    "mode": {
      "description": "Defaults to press-move-release. Click-move-click requires target and zero hold.",
      "anyOf": [
        {
          "$ref": "#/definitions/DragMode"
        },
        {
          "type": "null"
        }
      ]
    },
    "modifiers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/KeyModifier"
      }
    },
    "observation_id": {
      "description": "Sync's baseline for untargeted/visual actions under target policy. Strict-policy drag instead accepts its legacy ref-map observation token.",
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "$ref": "#/definitions/DragTarget"
    },
    "tab_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "target": {
      "description": "Exactly one of target or delta is required.",
      "anyOf": [
        {
          "$ref": "#/definitions/DragTarget"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 1.0
    }
  },
  "definitions": {
    "ActionExpectation": {
      "description": "Caller-supplied facts checked immediately before starting an action.",
      "type": "object",
      "required": [
        "equals",
        "field",
        "target"
      ],
      "properties": {
        "attribute": {
          "description": "Required only for field=attribute, measured in Unicode code points.",
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "equals": {
          "description": "text/value require a string; checked/exists require a boolean; attribute accepts a string or null for absence. Text is exact textContent.",
          "allOf": [
            {
              "$ref": "#/definitions/ExpectedValue"
            }
          ]
        },
        "field": {
          "$ref": "#/definitions/ExpectationField"
        },
        "target": {
          "description": "Observed ref or main-document CSS selector, measured in Unicode code points.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "DragMode": {
      "type": "string",
      "enum": [
        "press-move-release",
        "click-move-click"
      ]
    },
    "DragPoint": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "DragTarget": {
      "type": "object",
      "properties": {
        "offset": {
          "description": "Offset from the visible action point, in top-level viewport CSS pixels.",
          "anyOf": [
            {
              "$ref": "#/definitions/DragPoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ExpectationField": {
      "type": "string",
      "enum": [
        "text",
        "value",
        "checked",
        "attribute",
        "exists"
      ]
    },
    "ExpectedValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "KeyModifier": {
      "description": "Keyboard modifier flags. Multiple flags may be combined; the extension folds them into CDP's bitfield (`alt=1, ctrl=2, meta=4, shift=8`).",
      "type": "string",
      "enum": [
        "alt",
        "ctrl",
        "meta",
        "shift"
      ]
    },
    "MouseButton": {
      "description": "Mouse button selector for `tool.click`.",
      "type": "string",
      "enum": [
        "left",
        "middle",
        "right"
      ]
    }
  }
}
