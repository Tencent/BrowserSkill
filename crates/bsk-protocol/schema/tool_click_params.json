{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "KeyModifier": {
      "description": "Keyboard modifier flags. Multiple flags may be combined; the\nextension folds them into CDP's bitfield (`alt=1, ctrl=2, meta=4,\nshift=8`).",
      "enum": [
        "alt",
        "ctrl",
        "meta",
        "shift"
      ],
      "type": "string"
    },
    "MouseButton": {
      "description": "Mouse button selector for `tool.click`.",
      "enum": [
        "left",
        "middle",
        "right"
      ],
      "type": "string"
    }
  },
  "properties": {
    "button": {
      "anyOf": [
        {
          "$ref": "#/definitions/MouseButton"
        },
        {
          "type": "null"
        }
      ]
    },
    "capture_id": {
      "description": "Single-use capture returned by a visual-ref screenshot; requires image coordinates.",
      "type": [
        "string",
        "null"
      ]
    },
    "click_count": {
      "description": "Number of consecutive mouse presses (double-click = 2).",
      "format": "uint32",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "image_x": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "image_y": {
      "format": "double",
      "type": [
        "number",
        "null"
      ]
    },
    "modifiers": {
      "items": {
        "$ref": "#/definitions/KeyModifier"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "ref": {
      "description": "Optional `@e<N>` ref allocated by the last `tool.snapshot`.\nMutually exclusive with `selector` (caller must supply exactly\none). Accepts both `\"e3\"` and `\"@e3\"`.",
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "description": "Target tab. Defaults to the Agent Window's active tab.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout_ms": {
      "format": "uint32",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "session_id"
  ],
  "title": "ClickParams",
  "type": "object"
}
