{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CooperateParams",
  "type": "object",
  "required": [
    "action",
    "session_id"
  ],
  "properties": {
    "action": {
      "$ref": "#/definitions/CooperateAction"
    },
    "control_policy": {
      "description": "Omitted by legacy callers. A negotiated policy remains fixed for the session.",
      "anyOf": [
        {
          "$ref": "#/definitions/ControlPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "max_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "timeout_ms": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "definitions": {
    "ControlPolicy": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "strict",
            "target"
          ]
        },
        {
          "description": "Keep the negotiated policy, or choose target when the session is unconfigured.",
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ]
    },
    "CooperateAction": {
      "type": "string",
      "enum": [
        "enable",
        "status",
        "sync",
        "wait"
      ]
    }
  }
}
