{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ErrorCode": {
      "description": "Stable daemon/extension error codes (§4.5).",
      "enum": [
        "unknown_method",
        "unsupported",
        "invalid_params",
        "not_found",
        "permission_denied",
        "timeout",
        "cdp_failed",
        "protocol_error",
        "cancelled",
        "user_aborted",
        "version_too_old",
        "multiple_browsers_online",
        "no_browser_connected"
      ],
      "type": "string"
    },
    "ReturnFailure": {
      "properties": {
        "code": {
          "$ref": "#/definitions/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "tab_id": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "tab_id",
        "code",
        "message"
      ],
      "type": "object"
    }
  },
  "description": "Full extension response, including whether a window was left with the user.",
  "properties": {
    "return_failures": {
      "items": {
        "$ref": "#/definitions/ReturnFailure"
      },
      "type": "array"
    },
    "returned_tab_ids": {
      "items": {
        "format": "int64",
        "type": "integer"
      },
      "type": "array"
    },
    "window_released": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "title": "SessionStopOutcome",
  "type": "object"
}
