{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "JavaScriptDialogHandledAction": {
      "description": "How the extension resolved the dialog so CDP could continue.",
      "enum": [
        "accepted",
        "dismissed"
      ],
      "type": "string"
    },
    "JavaScriptDialogInfo": {
      "description": "One observed + handled JavaScript dialog during a tool call.",
      "properties": {
        "default_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "handled": {
          "$ref": "#/definitions/JavaScriptDialogHandledAction"
        },
        "has_browser_handler": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic per-tab sequence for ordering within a session.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tab_id": {
          "format": "int64",
          "type": "integer"
        },
        "type": {
          "$ref": "#/definitions/JavaScriptDialogType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tab_id",
        "type",
        "message",
        "handled",
        "sequence"
      ],
      "type": "object"
    },
    "JavaScriptDialogType": {
      "description": "Native JS dialog kind reported by CDP.",
      "enum": [
        "alert",
        "confirm",
        "prompt",
        "beforeunload"
      ],
      "type": "string"
    }
  },
  "properties": {
    "capture_id": {
      "description": "Single-use visual point-click capture, in the original PNG coordinate space.",
      "type": [
        "string",
        "null"
      ]
    },
    "capture_unavailable": {
      "description": "Image remains viewable but cannot authorize a point click.",
      "type": [
        "string",
        "null"
      ]
    },
    "dialogs": {
      "items": {
        "$ref": "#/definitions/JavaScriptDialogInfo"
      },
      "type": "array"
    },
    "format": {
      "description": "Always `\"png\"` in v0.1; reserved for future JPEG / WebP support.",
      "type": "string"
    },
    "height": {
      "default": 0,
      "description": "Pixel height (see [`Self::width`]).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "image_base64": {
      "description": "Base64-encoded PNG payload (no `data:` prefix).",
      "type": "string"
    },
    "tab_id": {
      "format": "int64",
      "type": "integer"
    },
    "width": {
      "default": 0,
      "description": "Pixel width parsed from the PNG IHDR. May be `0` when parsing\nfails (extension only logs a warning in that case so the agent\nstill gets the image).",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "image_base64",
    "format",
    "tab_id"
  ],
  "title": "ScreenshotResult",
  "type": "object"
}
