    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    },
    "title": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "definitions": {
    "ReadItem": {
      "type": "object",
      "required": [
        "redacted",
        "ref",
        "values"
      ],
      "properties": {
        "redacted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ref": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
