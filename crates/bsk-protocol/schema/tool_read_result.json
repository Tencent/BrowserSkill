{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReadResult",
  "type": "object",
  "required": [
    "captured_at",
    "frame_id",
    "frame_url",
    "items",
    "page_url",
    "scope",
    "tab_id",
    "title",
    "truncated"
  ],
  "properties": {
    "captured_at": {
      "type": "string"
    },
    "frame_id": {
      "type": "string"
    },
    "frame_url": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReadItem"
      }
    },
    "page_url": {
      "type": "string"
    },
    "scope": {
      "description": "A live sample, not an action authorization or a complete dataset.",
