{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HelpCompletionCondition": {
      "properties": {
        "selector_exists": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector_missing": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_exists": {
          "type": [
            "string",
            "null"
          ]
        },
        "text_missing": {
          "type": [
            "string",
            "null"
          ]
        },
        "url_contains": {
          "type": [
            "string",
            "null"
          ]
        },
        "url_matches": {
          "description": "RE2-compatible URL regex (maximum 128 characters). Backtracking-only syntax is rejected.",
          "maxLength": 128,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HelpCompletionCriteria": {
      "properties": {
        "all": {
          "items": {
            "$ref": "#/definitions/HelpCompletionCondition"
          },
          "maxItems": 8,
          "type": [
            "array",
            "null"
          ]
        },
        "any": {
          "items": {
            "$ref": "#/definitions/HelpCompletionCondition"
          },
          "maxItems": 8,
          "type": [
            "array",
            "null"
          ]
        },
        "stable_for_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HelpTarget": {
      "description": "One component the user is asked to look at / interact with. Exactly\none of `ref` / `selector` should be supplied (mirrors the\nclick/fill convention). When neither matches a live element the\noverlay still shows the prompt and reports the miss via\n[`ResolvedTarget`].",
      "properties": {
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "completion_criteria": {
      "anyOf": [
        {
          "$ref": "#/definitions/HelpCompletionCriteria"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional explicit success detector. Navigation by itself is not a\ncompletion signal; these criteria must match before the tool can\nauto-complete without the user clicking Done."
    },
    "prompt": {
      "description": "Message shown to the user explaining what to do.",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "description": "Target tab. Defaults to the Agent Window's active tab.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "targets": {
      "description": "Optional components to scroll to + flash-highlight.",
      "items": {
        "$ref": "#/definitions/HelpTarget"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "timeout_ms": {
      "description": "Hard upper bound on the wait. Defaults to 300000 (5 min),\nenforced daemon-side via the generic tool timeout.",
      "format": "uint32",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    },
    "title": {
      "description": "Optional custom title for the help overlay. Falls back to the\nextension's default localized title when omitted.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "session_id",
    "prompt"
  ],
  "title": "RequestHelpParams",
  "type": "object"
}
