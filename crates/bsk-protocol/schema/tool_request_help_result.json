{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "HelpCompletedBy": {
      "enum": [
        "system"
      ],
      "type": "string"
    },
    "HelpOutcome": {
      "oneOf": [
        {
          "const": "continued",
          "description": "User completed the step and clicked Done / return control.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "User declined / aborted via the overlay's Cancel button.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "The wait expired before the user acted.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Explicit success criteria matched while the user had control.",
          "type": "string"
        },
        {
          "const": "navigated",
          "description": "The page navigated while waiting (full reload or SPA URL change).\nDeprecated: navigation alone should not end a help request.",
          "type": "string"
        },
        {
          "const": "disabled",
          "description": "request-help is disabled by configuration (`BSK_REQUEST_HELP=off`):\nthe call returns immediately without ever showing the overlay.",
          "type": "string"
        }
      ]
    },
    "ResolvedTarget": {
      "description": "Per-target resolution status echoed back so the agent can tell which\n`ref` / `selector` actually matched a live element.",
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "matched"
      ],
      "type": "object"
    }
  },
  "properties": {
    "completed_by": {
      "anyOf": [
        {
          "$ref": "#/definitions/HelpCompletedBy"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "$ref": "#/definitions/HelpOutcome"
    },
    "resolved_targets": {
      "items": {
        "$ref": "#/definitions/ResolvedTarget"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "tab_id": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "outcome",
    "tab_id"
  ],
  "title": "RequestHelpResult",
  "type": "object"
}
