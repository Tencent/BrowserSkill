{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScreenshotReadParams",
  "type": "object",
  "required": [
    "capture_id",
    "offset",
    "session_id"
  ],
  "properties": {
    "capture_id": {
      "type": "string"
    },
    "offset": {
      "description": "Byte offset, allowing an interrupted chunk request to be retried.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "session_id": {
      "type": "string"
    }
  }
}
