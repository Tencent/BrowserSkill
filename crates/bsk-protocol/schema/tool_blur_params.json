{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "ref": {
      "description": "Optional `@e<N>` ref allocated by the last observation.\nMutually exclusive with `selector`.",
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "tab_id": {
      "description": "Target tab. Defaults to the Agent Window's active tab.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout_ms": {
      "format": "uint32",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "session_id"
  ],
  "title": "BlurParams",
  "type": "object"
}
