{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "JavaScriptDialogHandledAction": {
      "description": "How the extension resolved the dialog so CDP could continue.",
      "enum": [
        "accepted",
        "dismissed"
      ],
      "type": "string"
    },
    "JavaScriptDialogInfo": {
      "description": "One observed + handled JavaScript dialog during a tool call.",
      "properties": {
        "default_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "handled": {
          "$ref": "#/definitions/JavaScriptDialogHandledAction"
        },
        "has_browser_handler": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic per-tab sequence for ordering within a session.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tab_id": {
          "format": "int64",
          "type": "integer"
        },
        "type": {
          "$ref": "#/definitions/JavaScriptDialogType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tab_id",
        "type",
        "message",
        "handled",
        "sequence"
      ],
      "type": "object"
    },
    "JavaScriptDialogType": {
      "description": "Native JS dialog kind reported by CDP.",
      "enum": [
        "alert",
        "confirm",
        "prompt",
        "beforeunload"
      ],
      "type": "string"
    },
    "KeyModifier": {
      "description": "Keyboard modifier flags. Multiple flags may be combined; the\nextension folds them into CDP's bitfield (`alt=1, ctrl=2, meta=4,\nshift=8`).",
      "enum": [
        "alt",
        "ctrl",
        "meta",
        "shift"
      ],
      "type": "string"
    }
  },
  "properties": {
    "code": {
      "type": "string"
    },
    "dialogs": {
      "items": {
        "$ref": "#/definitions/JavaScriptDialogInfo"
      },
      "type": "array"
    },
    "key": {
      "type": "string"
    },
    "modifiers": {
      "default": [],
      "items": {
        "$ref": "#/definitions/KeyModifier"
      },
      "type": "array"
    },
    "tab_id": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "tab_id",
    "key",
    "code"
  ],
  "title": "PressResult",
  "type": "object"
}
