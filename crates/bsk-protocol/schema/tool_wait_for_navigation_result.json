{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "JavaScriptDialogHandledAction": {
      "description": "How the extension resolved the dialog so CDP could continue.",
      "enum": [
        "accepted",
        "dismissed"
      ],
      "type": "string"
    },
    "JavaScriptDialogInfo": {
      "description": "One observed + handled JavaScript dialog during a tool call.",
      "properties": {
        "default_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "handled": {
          "$ref": "#/definitions/JavaScriptDialogHandledAction"
        },
        "has_browser_handler": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic per-tab sequence for ordering within a session.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tab_id": {
          "format": "int64",
          "type": "integer"
        },
        "type": {
          "$ref": "#/definitions/JavaScriptDialogType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "tab_id",
        "type",
        "message",
        "handled",
        "sequence"
      ],
      "type": "object"
    },
    "JavaScriptDialogType": {
      "description": "Native JS dialog kind reported by CDP.",
      "enum": [
        "alert",
        "confirm",
        "prompt",
        "beforeunload"
      ],
      "type": "string"
    },
    "WaitForNavigationReached": {
      "enum": [
        "load",
        "domcontentloaded",
        "networkidle",
        "commit",
        "timeout"
      ],
      "type": "string"
    }
  },
  "description": "Outcome of a wait_for_navigation. `reached` is the wire name of the\nlifecycle phase the extension actually observed before returning —\neither the requested `wait_until`, or `\"timeout\"` when the wait\nexpired before that event fired.",
  "properties": {
    "dialogs": {
      "items": {
        "$ref": "#/definitions/JavaScriptDialogInfo"
      },
      "type": "array"
    },
    "error_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "reached": {
      "$ref": "#/definitions/WaitForNavigationReached"
    },
    "tab_id": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "tab_id",
    "reached"
  ],
  "title": "WaitForNavigationResult",
  "type": "object"
}
