{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "fallback": {
      "description": "True when the original window had been closed and we fell back\nto either the last focused normal window or a newly-created\nwindow. Lets the CLI surface \"tab returned to a different\nwindow\" hints.",
      "type": "boolean"
    },
    "returned_to_index": {
      "format": "int32",
      "type": "integer"
    },
    "returned_to_window_id": {
      "format": "int64",
      "type": "integer"
    },
    "tab_id": {
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "tab_id",
    "returned_to_window_id",
    "returned_to_index"
  ],
  "title": "TabReturnResult",
  "type": "object"
}
