{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "KeyModifier": {
      "description": "Keyboard modifier flags. Multiple flags may be combined; the\nextension folds them into CDP's bitfield (`alt=1, ctrl=2, meta=4,\nshift=8`).",
      "enum": [
        "alt",
        "ctrl",
        "meta",
        "shift"
      ],
      "type": "string"
    }
  },
  "properties": {
    "modifiers": {
      "items": {
        "$ref": "#/definitions/KeyModifier"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "ref": {
      "description": "Optional `@e<N>` ref allocated by the last observation.\nMutually exclusive with `selector`.",
      "type": [
        "string",
        "null"
      ]
    },
    "selector": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "settle_ms": {
      "description": "Wait after the mouse move so hover-triggered UI can settle.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "tab_id": {
      "description": "Target tab. Defaults to the Agent Window's active tab.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "timeout_ms": {
      "format": "uint32",
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "session_id"
  ],
  "title": "HoverParams",
  "type": "object"
}
